# ============================================================
#  CodeX — Environment Variables Example
#  Copy this file to `.env` and adjust as needed:
#    cp .env.example .env
#  NEVER commit the real `.env` to git. That's how secrets leak.
# ============================================================

# --- Ollama (local model server) ---
# Default Ollama endpoint. If you changed the port, update this.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama

# --- Model config ---
# Which model CodeX should use. Change if you pulled a different one.
CODEX_MODEL=codex
CODEX_MODEL_BASE=deepseek-coder:6.7b

# --- Persona params ---
# Temperature: 0 = robot, 1 = chaotic gremlin. 0.8 is the sweet spot.
CODEX_TEMPERATURE=0.8
CODEX_TOP_P=0.9
CODEX_REPEAT_PENALTY=1.1
CODEX_NUM_CTX=8192

# --- OpenCode client config ---
OPENCODE_PROVIDER=ollama
OPENCODE_BASE_URL=http://localhost:11434/v1
OPENCODE_API_KEY=ollama
OPENCODE_MODEL=ollama/codex

# --- Docker sandbox ---
# Sandbox image name. Change if you built with a different tag.
SANDBOX_IMAGE=sandbox
# Set to "none" to disable internet inside the sandbox (recommended).
SANDBOX_NETWORK=none

# --- Logging / debug ---
# Set to "true" if you want verbose logs. Set to "false" if you value your sanity.
CODEX_DEBUG=false
CODEX_LOG_LEVEL=info

# --- Paths ---
# Where your sandbox Dockerfile lives.
SANDBOX_DIR=./codex-sandbox
# Where your working scripts are stored.
WORK_DIR=./work

# ============================================================
#  Reminder: `.env` is gitignored. `.env.example` is not.
#  Don't be the person who commits their API keys. Please.
# ============================================================